# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Both variables below are safe to expose to the browser (NEXT_PUBLIC_*) — the
# anon/publishable key is meant to be public; Supabase's Row Level Security
# policies, not key secrecy, are what protect data. The service-role key and
# any other server-only secret belong in the backend repo's .env, never here.

NEXT_PUBLIC_SUPABASE_URL=https://vrwwzeueatpuqeimuvdv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_x0M9mCL1lpJR8mpb9HvXXg_QdTZEKB4
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
